<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>food-delivery.Platform</groupId>
	<artifactId>fdp</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>fdp</name>
	<description>Food Delivery Platform - microservices aggregator. See docs/RULES.md.</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>

	<properties>
		<java.version>25</java.version>
	</properties>

	<!--
		This is a pure aggregator: packaging=pom, no <dependencies>, no <build><plugins> that
		would force-inherit onto every module. Per docs/RULES.md §4, dependency VERSIONS are
		centralized here (via <dependencyManagement>, added once a module actually needs a BOM
		such as spring-cloud-dependencies); each service's own pom.xml declares the actual
		dependencies it uses.
	-->
	<modules>
		<module>common</module>
		<module>config-server</module>
		<module>discovery-server</module>
		<module>api-gateway</module>
		<module>customer-service</module>
		<module>restaurant-service</module>
		<module>order-service</module>
		<module>delivery-service</module>
		<module>notification-service</module>
	</modules>

	<!--
		pluginManagement only, not plugins, so nothing here is force-applied to a module that
		doesn't declare the plugin itself. This exists so a service that adds the (optional)
		Lombok dependency for its JPA entities gets working annotation processing without every
		such service repeating this same XML block.
	-->
	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

</project>
