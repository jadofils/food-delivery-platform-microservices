<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>food-delivery.Platform</groupId>
		<artifactId>fdp</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>common</artifactId>
	<name>common</name>
	<description>
		FDP shared kernel. Cross-cutting types only (event payloads, DomainException hierarchy,
		ApiErrorResponse DTO, JWT-claims parsing utilities) — never a JPA entity/repository. See
		docs/RULES.md §3.
	</description>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!--
			spring-web only — not spring-boot-starter-web. This gives @ExceptionHandler,
			@RestControllerAdvice, ResponseEntity, and MethodArgumentNotValidException without
			pulling in an embedded servlet container, so api-gateway (WebFlux) doesn't inherit a
			Tomcat dependency it doesn't want just by depending on common.
		-->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-web</artifactId>
		</dependency>
		<!--
			provided: AbstractGlobalExceptionHandler targets the Servlet (Spring MVC) stack used by
			every service except api-gateway. "provided" means this API is visible to compile
			against here but is not pulled onto any consumer's runtime classpath by depending on
			common — each MVC-based service already brings the real servlet container itself via
			spring-boot-starter-web.
		-->
		<dependency>
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>
