<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>food-delivery.Platform</groupId>
		<artifactId>fdp</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>api-gateway</artifactId>
	<name>api-gateway</name>
	<description>FDP single entry point: routing, JWT validation, rate limiting. See docs/services/api-gateway.md.</description>

	<dependencies>
		<!--
			common is safe to depend on from a WebFlux service: its Servlet-typed classes
			(AbstractGlobalExceptionHandler, RestAuthenticationEntryPoint/RestAccessDeniedHandler) are
			"provided" scope in common's own pom.xml, so they never reach this module's runtime
			classpath; only the stack-agnostic pieces this module actually uses (JwtClaims,
			KeycloakRoleConverter, the DomainException hierarchy, ApiErrorResponse) come along.
		-->
		<dependency>
			<groupId>food-delivery.Platform</groupId>
			<artifactId>common</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!--
			WebFlux, not spring-boot-starter-web: Spring Cloud Gateway is reactive-only (RULES.md
			§14, this is the one service not on the Servlet/MVC stack the rest of FDP uses). Boot
			refuses to auto-configure both an embedded Tomcat and a reactive server in the same
			context, so starter-web must never also be on this module's classpath.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux</artifactId>
		</dependency>
		<!-- Version managed by the root aggregator's spring-cloud-dependencies BOM import. This
			 Spring Cloud train renamed the old spring-cloud-starter-gateway artifact to this
			 WebFlux-specific one (a WebMVC-flavored gateway variant now exists as a sibling
			 artifact); confirmed against the actual spring-cloud-gateway-dependencies BOM for the
			 version this root POM imports, not just docs/technologies/spring-cloud-gateway.md's
			 older "spring-cloud-starter-gateway" name. -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
		</dependency>
		<!-- Route resolution via lb://<service-name> (RULES.md §6) -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>
		<!-- Edge JWT validation (signature/expiry) against Keycloak's JWKS endpoint (RULES.md §8,
			 SPRINTS.md Sprint 4). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>
		<!-- Backs the order-placement route's RequestRateLimiter (RULES.md §12, SPRINTS.md Sprint
			 4); one starter, not a separate "-reactive" artifact: Spring Boot autoconfigures the
			 reactive ReactiveRedisConnectionFactory Gateway's RedisRateLimiter needs directly off
			 this starter's Lettuce client once a reactive web app (WebFlux) is on the classpath. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- SecurityMockServerConfigurers.mockJwt(): the WebTestClient/WebFlux equivalent of
			 SecurityMockMvcRequestPostProcessors.jwt() every other service's tests already use. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Core testcontainers only (GenericContainer), not testcontainers-postgresql/-rabbitmq:
			 this module's only container is Redis, and (per restaurant-service's own
			 AbstractIntegrationTest) Testcontainers has no dedicated Redis module. -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!--
				*IT.java classes are Testcontainers-backed integration tests (RULES.md §9). Surefire's
				default include pattern (*Test.java, *Tests.java, *TestCase.java) skips *IT.java on
				purpose, since that naming convention is Failsafe's, bound to the integration-test/verify
				phases rather than plain `test`.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
