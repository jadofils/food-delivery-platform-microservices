<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>food-delivery.Platform</groupId>
		<artifactId>fdp</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>identity-service</artifactId>
	<name>identity-service</name>
	<description>FDP users, roles, permissions (RBAC), JWT issuance. See docs/services/identity-service.md.</description>

	<dependencies>
		<!-- Shared error-handling kernel: DomainException hierarchy, ApiErrorResponse, AbstractGlobalExceptionHandler -->
		<dependency>
			<groupId>food-delivery.Platform</groupId>
			<artifactId>common</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!-- Explicit: Boot 4 didn't transitively resolve the module that registers an injectable
			 ObjectMapper bean via spring-boot-starter-web alone here (JwtAuthenticationFilter's
			 constructor needs one directly). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-jackson</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Password hashing only, not the full spring-boot-starter-security auto-configuration.
			 JWT issuance/validation is handled by common's lightweight jwt kernel (see
			 SecurityConfig) instead of Spring Security's resource-server support. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>
		<!-- Used directly (RSAKeyGenerator) in SecurityConfig to build the signing keypair;
			 version centralized in the root aggregator's dependencyManagement. -->
		<dependency>
			<groupId>com.nimbusds</groupId>
			<artifactId>nimbus-jose-jwt</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Boot 4 moved Flyway's autoconfiguration out of the monolithic autoconfigure jar into
			 its own module, mirroring the webmvc-test/hibernate splits -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- OpenAPI 3 spec + Swagger UI, generated from the controllers -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.1.0</version>
		</dependency>

		<!-- JPA entities can't be records; Lombok removes their getter/setter boilerplate.
			 DTOs stay plain Java records (see dto package); Lombok is for entities only. -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Boot 4 split MockMvc test support out of spring-boot-test-autoconfigure into its own
			 module, mirroring the webmvc/webflux starter split -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- @ServiceConnection support: a @Testcontainers Postgres container auto-wires the
			 datasource with no manual @DynamicPropertySource. Versions come from the Spring Boot
			 BOM inherited via the parent, not pinned here. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Testcontainers 2.x renamed these from the 1.x-era "junit-jupiter"/"postgresql" -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- No <configuration> here; inherited from the root aggregator's pluginManagement,
				 which wires Lombok as an annotation processor. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
