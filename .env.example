# Copy this file to .env and adjust values for your machine if needed.
# The values below match docker-compose.yml's built-in defaults, so .env is optional for local
# dev — docker compose up works with none of these set.
#
# NEVER commit a real .env file — it's gitignored on purpose (see .gitignore's Secrets section).
# These are local-development-only defaults; production credentials come from Config Server /
# environment injection per RULES.md §3 (factor 3) and §8, never from this file.

POSTGRES_USER=fdp
POSTGRES_PASSWORD=fdp
POSTGRES_DB=fdp
POSTGRES_PORT=5432

MONGO_ROOT_USERNAME=fdp
MONGO_ROOT_PASSWORD=fdp
MONGO_PORT=27017

RABBITMQ_USER=fdp
RABBITMQ_PASSWORD=fdp
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

REDIS_PASSWORD=fdp
REDIS_PORT=6379

# Keycloak's own admin console login (master realm) — NOT the fdp realm's demo users, see
# credentials.md for those.
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=kcadmin
KEYCLOAK_PORT=8180
