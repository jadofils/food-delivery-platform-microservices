{
	"info": {
		"_postman_id": "fdp-restaurant-service-collection",
		"name": "FDP - restaurant-service (registration + menu + browsing)",
		"description": "Exercises Keycloak-issued auth and restaurant-service's registration/profile/menu-item endpoints, plus public browsing, against a locally running stack (`docker compose up -d postgres keycloak`, then run `restaurant-service` on :8083). Import the sibling `FDP.postman_environment.json` and select it before running.\n\nRun order: **1. Get Tokens** first, then the rest in numeric folder order. Folder 2's Register request must run before folders 3/4 (they reuse the `restaurantId` it saves). See `docs/services/restaurant-service.md` and `credentials.md` for background.\n\nNote: only one seeded RESTAURANT_OWNER account exists (`restaurant-owner@fdp.test`), so the \"before registering\" 404 check in folder 2 only passes against a clean database — truncate `restaurant_db`'s `restaurants`/`menu_items` tables before a full run if you've registered with that account before.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Get Tokens (Keycloak)",
			"description": "Same as customer-service's collection -- reuses the same environment variables, so running either collection's token folder is enough if you're testing both together.",
			"item": [
				{
					"name": "Get Restaurant Owner Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const body = pm.response.json();",
									"pm.test('token issued', () => pm.expect(body.access_token).to.be.a('string'));",
									"pm.environment.set('restaurantOwnerToken', body.access_token);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "grant_type", "value": "password" },
								{ "key": "client_id", "value": "{{clientId}}" },
								{ "key": "username", "value": "{{restaurantOwnerUsername}}" },
								{ "key": "password", "value": "{{restaurantOwnerPassword}}" }
							]
						},
						"url": {
							"raw": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
							"host": ["{{keycloakUrl}}"],
							"path": ["realms", "{{realm}}", "protocol", "openid-connect", "token"]
						}
					}
				},
				{
					"name": "Get Customer Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const body = pm.response.json();",
									"pm.test('token issued', () => pm.expect(body.access_token).to.be.a('string'));",
									"pm.environment.set('customerToken', body.access_token);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "grant_type", "value": "password" },
								{ "key": "client_id", "value": "{{clientId}}" },
								{ "key": "username", "value": "{{customerUsername}}" },
								{ "key": "password", "value": "{{customerPassword}}" }
							]
						},
						"url": {
							"raw": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
							"host": ["{{keycloakUrl}}"],
							"path": ["realms", "{{realm}}", "protocol", "openid-connect", "token"]
						}
					}
				},
				{
					"name": "Get Delivery Agent Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const body = pm.response.json();",
									"pm.test('token issued', () => pm.expect(body.access_token).to.be.a('string'));",
									"pm.environment.set('deliveryAgentToken', body.access_token);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "grant_type", "value": "password" },
								{ "key": "client_id", "value": "{{clientId}}" },
								{ "key": "username", "value": "{{deliveryAgentUsername}}" },
								{ "key": "password", "value": "{{deliveryAgentPassword}}" }
							]
						},
						"url": {
							"raw": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
							"host": ["{{keycloakUrl}}"],
							"path": ["realms", "{{realm}}", "protocol", "openid-connect", "token"]
						}
					}
				}
			]
		},
		{
			"name": "2. Restaurant Registration & Profile (owner self-service)",
			"description": "Gated by restaurant:menu:write (RULES.md §8) -- ownership resolved from the caller's own token, never a client-supplied id.",
			"item": [
				{
					"name": "Get My Restaurant - before registering (expect 404)",
					"event": [
						{
							"listen": "test",
							"script": { "type": "text/javascript", "exec": ["pm.test('not registered yet', () => pm.response.to.have.status(404));"] }
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{restaurantOwnerToken}}" }],
						"url": { "raw": "{{restaurantServiceUrl}}/api/restaurants/me", "host": ["{{restaurantServiceUrl}}"], "path": ["api", "restaurants", "me"] }
					}
				},
				{
					"name": "Register (POST /me)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('created', () => pm.response.to.have.status(201));",
									"const body = pm.response.json();",
									"pm.test('open by default', () => pm.expect(body.isOpen).to.eql(true));",
									"pm.environment.set('restaurantId', body.id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{restaurantOwnerToken}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Kigali Grill\",\n  \"description\": \"Grilled specialties\",\n  \"cuisineType\": \"Rwandan\",\n  \"street\": \"1 Downtown Ave\",\n  \"city\": \"Kigali\",\n  \"state\": \"Kigali City\",\n  \"postalCode\": \"00000\",\n  \"country\": \"Rwanda\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{restaurantServiceUrl}}/api/restaurants/me", "host": ["{{restaurantServiceUrl}}"], "path": ["api", "restaurants", "me"] }
					}
				},
				{
					"name": "Register again -> 409 Conflict",
					"event": [
						{
							"listen": "test",
							"script": { "type": "text/javascript", "exec": ["pm.test('conflict on repeat registration', () => pm.response.to.have.status(409));"] }
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{restaurantOwnerToken}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Kigali Grill\",\n  \"cuisineType\": \"Rwandan\",\n  \"street\": \"1 Ave\",\n  \"city\": \"Kigali\",\n  \"state\": \"Kigali City\",\n  \"postalCode\": \"00000\",\n  \"country\": \"Rwanda\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{restaurantServiceUrl}}/api/restaurants/me", "host": ["{{restaurantServiceUrl}}"], "path": ["api", "restaurants", "me"] }
					}
				},
				{
					"name": "Get My Restaurant",
					"event": [
						{
							"listen": "test",
							"script": { "type": "text/javascript", "exec": ["pm.test('ok', () => pm.response.to.have.status(200));"] }
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{restaurantOwnerToken}}" }],
						"url": { "raw": "{{restaurantServiceUrl}}/api/restaurants/me", "host": ["{{restaurantServiceUrl}}"], "path": ["api", "restaurants", "me"] }
					}
				},
				{
					"name": "Update My Restaurant (close for the day)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('ok', () => pm.response.to.have.status(200));",
									"pm.test('now closed', () => pm.expect(pm.response.json().isOpen).to.eql(false));"
								]
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{restaurantOwnerToken}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Kigali Grill\",\n  \"description\": \"Grilled specialties\",\n  \"cuisineType\": \"Rwandan\",\n  \"street\": \"1 Downtown Ave\",\n  \"city\": \"Kigali\",\n  \"state\": \"Kigali City\",\n  \"postalCode\": \"00000\",\n  \"country\": \"Rwanda\",\n  \"isOpen\": false\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{restaurantServiceUrl}}/api/restaurants/me", "host": ["{{restaurantServiceUrl}}"], "path": ["api", "restaurants", "me"] }
					}
				}
			]
		},
		{
			"name": "3. Menu Items (owner self-service)",
			"item": [
				{
					"name": "Add Menu Item",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('created', () => pm.response.to.have.status(201));",
									"pm.environment.set('menuItemId', pm.response.json().id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{restaurantOwnerToken}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Brochette\",\n  \"description\": \"Grilled skewers\",\n  \"price\": 5.50,\n  \"category\": \"Mains\",\n  \"available\": true\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{restaurantServiceUrl}}/api/restaurants/me/menu-items", "host": ["{{restaurantServiceUrl}}"], "path": ["api", "restaurants", "me", "menu-items"] }
					}
				},
				{
					"name": "Add Menu Item with negative price -> 400",
					"event": [
						{
							"listen": "test",
							"script": { "type": "text/javascript", "exec": ["pm.test('validation failed', () => pm.response.to.have.status(400));"] }
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{restaurantOwnerToken}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Bad Item\",\n  \"price\": -1,\n  \"category\": \"Mains\",\n  \"available\": true\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{restaurantServiceUrl}}/api/restaurants/me/menu-items", "host": ["{{restaurantServiceUrl}}"], "path": ["api", "restaurants", "me", "menu-items"] }
					}
				},
				{
					"name": "List My Menu Items",
					"event": [
						{
							"listen": "test",
							"script": { "type": "text/javascript", "exec": ["pm.test('ok', () => pm.response.to.have.status(200));", "pm.test('has at least one', () => pm.expect(pm.response.json().length).to.be.above(0));"] }
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{restaurantOwnerToken}}" }],
						"url": { "raw": "{{restaurantServiceUrl}}/api/restaurants/me/menu-items", "host": ["{{restaurantServiceUrl}}"], "path": ["api", "restaurants", "me", "menu-items"] }
					}
				},
				{
					"name": "Get One Menu Item",
					"event": [
						{
							"listen": "test",
							"script": { "type": "text/javascript", "exec": ["pm.test('ok', () => pm.response.to.have.status(200));"] }
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{restaurantOwnerToken}}" }],
						"url": {
							"raw": "{{restaurantServiceUrl}}/api/restaurants/me/menu-items/{{menuItemId}}",
							"host": ["{{restaurantServiceUrl}}"],
							"path": ["api", "restaurants", "me", "menu-items", "{{menuItemId}}"]
						}
					}
				},
				{
					"name": "Update Menu Item",
					"event": [
						{
							"listen": "test",
							"script": { "type": "text/javascript", "exec": ["pm.test('ok', () => pm.response.to.have.status(200));"] }
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{restaurantOwnerToken}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Brochette Deluxe\",\n  \"description\": \"Grilled skewers, bigger\",\n  \"price\": 7.00,\n  \"category\": \"Mains\",\n  \"available\": true\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{restaurantServiceUrl}}/api/restaurants/me/menu-items/{{menuItemId}}",
							"host": ["{{restaurantServiceUrl}}"],
							"path": ["api", "restaurants", "me", "menu-items", "{{menuItemId}}"]
						}
					}
				},
				{
					"name": "Customer Cannot Add Menu Item -> 403",
					"event": [
						{
							"listen": "test",
							"script": { "type": "text/javascript", "exec": ["pm.test('forbidden', () => pm.response.to.have.status(403));"] }
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{customerToken}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Hijack\",\n  \"price\": 1,\n  \"category\": \"Mains\",\n  \"available\": true\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{restaurantServiceUrl}}/api/restaurants/me/menu-items", "host": ["{{restaurantServiceUrl}}"], "path": ["api", "restaurants", "me", "menu-items"] }
					}
				}
			]
		},
		{
			"name": "4. Public Browsing (customer)",
			"description": "Gated by restaurant:menu:read -- the seeded CUSTOMER account has this, so any authenticated customer can browse without owning anything.",
			"item": [
				{
					"name": "List All Restaurants",
					"event": [
						{
							"listen": "test",
							"script": { "type": "text/javascript", "exec": ["pm.test('ok', () => pm.response.to.have.status(200));", "pm.test('paged shape', () => pm.expect(pm.response.json()).to.have.property('content'));"] }
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
						"url": { "raw": "{{restaurantServiceUrl}}/api/restaurants", "host": ["{{restaurantServiceUrl}}"], "path": ["api", "restaurants"] }
					}
				},
				{
					"name": "Get Restaurant By Id",
					"event": [
						{
							"listen": "test",
							"script": { "type": "text/javascript", "exec": ["pm.test('ok', () => pm.response.to.have.status(200));"] }
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
						"url": {
							"raw": "{{restaurantServiceUrl}}/api/restaurants/{{restaurantId}}",
							"host": ["{{restaurantServiceUrl}}"],
							"path": ["api", "restaurants", "{{restaurantId}}"]
						}
					}
				},
				{
					"name": "Browse Restaurant's Menu Items",
					"event": [
						{
							"listen": "test",
							"script": { "type": "text/javascript", "exec": ["pm.test('ok', () => pm.response.to.have.status(200));", "pm.test('has at least one item', () => pm.expect(pm.response.json().length).to.be.above(0));"] }
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
						"url": {
							"raw": "{{restaurantServiceUrl}}/api/restaurants/{{restaurantId}}/menu-items",
							"host": ["{{restaurantServiceUrl}}"],
							"path": ["api", "restaurants", "{{restaurantId}}", "menu-items"]
						}
					}
				}
			]
		},
		{
			"name": "5. Negative / Security Tests",
			"item": [
				{
					"name": "No Token -> 401",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('unauthorized', () => pm.response.to.have.status(401));",
									"pm.test('shared error envelope', () => pm.expect(pm.response.json().error).to.eql('UNAUTHORIZED'));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{restaurantServiceUrl}}/api/restaurants/me", "host": ["{{restaurantServiceUrl}}"], "path": ["api", "restaurants", "me"] }
					}
				},
				{
					"name": "Garbage Token -> 401",
					"event": [
						{
							"listen": "test",
							"script": { "type": "text/javascript", "exec": ["pm.test('unauthorized', () => pm.response.to.have.status(401));"] }
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer not-a-real-jwt" }],
						"url": { "raw": "{{restaurantServiceUrl}}/api/restaurants/me", "host": ["{{restaurantServiceUrl}}"], "path": ["api", "restaurants", "me"] }
					}
				},
				{
					"name": "Customer Cannot Register a Restaurant -> 403",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('forbidden, not unauthorized', () => pm.response.to.have.status(403));",
									"pm.test('shared error envelope', () => pm.expect(pm.response.json().error).to.eql('FORBIDDEN'));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{customerToken}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Hijack\",\n  \"cuisineType\": \"x\",\n  \"street\": \"x\",\n  \"city\": \"x\",\n  \"state\": \"x\",\n  \"postalCode\": \"x\",\n  \"country\": \"x\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{restaurantServiceUrl}}/api/restaurants/me", "host": ["{{restaurantServiceUrl}}"], "path": ["api", "restaurants", "me"] }
					}
				},
				{
					"name": "Delivery Agent Cannot Browse Restaurants -> 403",
					"event": [
						{
							"listen": "test",
							"script": { "type": "text/javascript", "exec": ["pm.test('forbidden -- lacks restaurant:menu:read', () => pm.response.to.have.status(403));"] }
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{deliveryAgentToken}}" }],
						"url": {
							"raw": "{{restaurantServiceUrl}}/api/restaurants/{{restaurantId}}",
							"host": ["{{restaurantServiceUrl}}"],
							"path": ["api", "restaurants", "{{restaurantId}}"]
						},
						"description": "delivery-agent@fdp.test's role set (delivery:status:update, delivery:read, order:read) doesn't include restaurant:menu:read -- see docker/keycloak/fdp-realm.json."
					}
				}
			]
		}
	]
}
