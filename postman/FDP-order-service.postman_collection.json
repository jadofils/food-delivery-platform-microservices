				{
					"name": "Place Order With Empty Items -> 400 Validation",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('validation failed', () => pm.response.to.have.status(400));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{customerToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"restaurantId\": {{restaurantId}},\n  \"deliveryAddressId\": {{addressId}},\n  \"items\": []\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{orderServiceUrl}}/api/orders/me",
							"host": [
								"{{orderServiceUrl}}"
							],
							"path": [
								"api",
								"orders",
								"me"
							]
						}
					}
				},
				{
					"name": "Another Customer Cannot See This Order -> 404",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('not found for a different owner', () => pm.response.to.have.status(404));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{deliveryAgentToken}}"
							}
						],
						"url": {
							"raw": "{{orderServiceUrl}}/api/orders/me/{{orderId}}",
							"host": [
								"{{orderServiceUrl}}"
							],
							"path": [
								"api",
								"orders",
								"me",
								"{{orderId}}"
							]
						},
						"description": "delivery-agent has order:read (so this isn't a 403), but this order doesn't belong to them -- the ownership check 404s the same way it would for a genuinely different customer."
					}
				}
			]
		}
	]
}
