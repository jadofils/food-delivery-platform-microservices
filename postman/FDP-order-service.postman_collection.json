		{
			"name": "3. Place & Manage Orders",
			"description": "Every request here goes through order-service's real OpenFeign calls to customer-service and restaurant-service (RULES.md §6) -- price and item name are always the restaurant's own current values, snapshotted server-side, never trusted from the request body.",
			"item": [
				{
					"name": "Place Order",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('created', () => pm.response.to.have.status(201));",
									"const body = pm.response.json();",
									"pm.test('status is PLACED', () => pm.expect(body.status).to.eql('PLACED'));",
									"pm.test('price snapshotted from restaurant-service, not the request', () => pm.expect(body.totalAmount).to.eql(11.00));",
									"pm.environment.set('orderId', body.id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
